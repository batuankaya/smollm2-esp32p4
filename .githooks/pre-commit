#!/bin/sh
# Model ağırlıklarının, veri setlerinin ve büyük dosyaların git'e girmesini engeller.
# Kurulum (bir kez): git config core.hooksPath .githooks
# Bilerek atlamak için: git commit --no-verify

MAX_BYTES=5242880  # 5 MiB
fail=0

for f in $(git diff --cached --name-only --diff-filter=AM); do
    case "$f" in
        data/*|checkpoints/*)
            echo "ENGEL: $f -> data/ ve checkpoints/ git'e girmez"; fail=1; continue ;;
        *.safetensors|*.bin|*.pt|*.pth|*.gguf|*.ckpt|*.onnx|*.npy|*.npz)
            echo "ENGEL: $f -> model/ağırlık dosyası uzantısı"; fail=1; continue ;;
    esac
    size=$(git cat-file -s ":$f" 2>/dev/null || echo 0)
    if [ "$size" -gt "$MAX_BYTES" ]; then
        echo "ENGEL: $f -> $((size / 1048576)) MiB (sınır 5 MiB)"; fail=1
    fi
done

if [ "$fail" -ne 0 ]; then
    echo "Commit iptal edildi. Dosyaları 'git restore --staged <dosya>' ile çıkarın."
    exit 1
fi
exit 0
